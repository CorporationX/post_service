<configuration>

    <property name="SERVICE_NAME" value="${spring.profiles.active:-default}"/>

    <property name="LOG_PATTERN" value="%d{HH:mm:ss.SSS} [%green(%thread)] %highlight(%-5level){ERROR=red, WARN=yellow, INFO=blue, DEBUG=green} %cyan(%logger{36}) - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <outputPatternAsHeader>true</outputPatternAsHeader>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <outputPatternAsHeader>true</outputPatternAsHeader>
        </encoder>
    </appender>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
